<div class="row player-page">
    <div class="col s12">
        <div class="card">
            <div class="card-content">
                <div class="player-profile-header">
                    <div class="player-avatar-wrap">
                        {{#if player.account.picture}}
                        <img class="player-avatar" src="{{player.account.picture}}" alt="Avatar">
                        {{else}}
                        <div class="player-avatar player-avatar-placeholder">
                            <i class="material-icons">person</i>
                        </div>
                        {{/if}}
                    </div>
                    <div class="player-profile-info">
                        <h4 class="player-name">{{player.name}}</h4>
                        {{#if player.account.nickname}}
                        <span class="player-username grey-text">#{{player.account.nickname}}</span>
                        {{/if}}
                        {{#if player.account.email}}
                        <span class="player-email grey-text text-darken-1">{{player.account.email}}</span>
                        {{/if}}
                        <span class="player-since grey-text">Member since {{formatDateTime player.createdAt}}</span>
                    </div>
                    <div class="player-profile-stats">
                        <div class="player-stat-chip">
                            <span class="player-stat-value">{{rosters.length}}</span>
                            <span class="player-stat-label">Rosters</span>
                        </div>
                        <div class="player-stat-chip">
                            <span class="player-stat-value">{{campaigns.length}}</span>
                            <span class="player-stat-label">Campaigns</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col s12">
        <div class="col s4">
            <div class="card">
                <div class="card-content">
                    <span class="card-title">Create Roster</span>
                    <form method="POST" action="/rosters/create">
                        <input type="hidden" name="player" value="{{player._id}}">
                        <div class="input-field">
                            <input id="new-roster-name" name="name" type="text" required>
                            <label for="new-roster-name">Name</label>
                        </div>
                        <div class="input-field">
                            <select id="new-roster-warband" name="warband" required>
                                <option value="" disabled selected>Choose warband</option>
                                {{#each warbands}}
                                <option value="{{this._id}}">{{this.name}}</option>
                                {{/each}}
                            </select>
                            <label for="new-roster-warband" class="active">Warband</label>
                        </div>
                        <div class="input-field">
                            <textarea id="new-roster-description" name="description" class="materialize-textarea"></textarea>
                            <label for="new-roster-description">Description</label>
                        </div>
                        <button class="btn waves-effect waves-light" type="submit">
                            <i class="fa fa-plus" style="margin-right:6px;"></i>Create Roster
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col s8">
            <div class="card">
                <div class="card-content">
                    <span class="card-title">Rosters</span>
                    {{#if rosters.length}}
                    <table class="striped responsive-table player-rosters-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Warband</th>
                                <th>Members</th>
                                <th>Rating</th>
                                <th>Gold</th>
                                <th>Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each rosters}}
                            <tr>
                                <td>{{{link this.name (concat '/rosters/roster/' this._id)}}}</td>
                                <td>
                                    {{#if this.warband}}
                                    <a href="/warbands/warband/{{this.warband._id}}">{{this.warband.name}}</a>
                                    {{else}}-{{/if}}
                                </td>
                                <td>{{this.memberCount}}</td>
                                <td>{{this.rating}}</td>
                                <td>{{this.gold}}</td>
                                <td>{{formatDateTime this.createdAt}}</td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                    {{else}}
                    <p class="grey-text">No rosters yet. Create one using the form on the left.</p>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>

    <div class="col s12">
        <div class="col s4">
            <div class="card">
                <div class="card-content">
                    <span class="card-title">Create Campaign</span>
                    <form method="POST" action="/campaigns/create">
                        <input type="hidden" name="player" value="{{player._id}}">
                        <div class="input-field">
                            <input id="new-campaign-name" name="name" type="text" required>
                            <label for="new-campaign-name">Name</label>
                        </div>
                        <div class="input-field">
                            <select id="new-campaign-warband" name="warband" required>
                                <option value="" disabled selected>Choose warband</option>
                                {{#each warbands}}
                                <option value="{{this._id}}">{{this.name}}</option>
                                {{/each}}
                            </select>
                            <label for="new-campaign-warband" class="active">Warband</label>
                        </div>
                        <div class="input-field">
                            <textarea id="new-campaign-description" name="description" class="materialize-textarea"></textarea>
                            <label for="new-campaign-description">Description</label>
                        </div>
                        <button class="btn waves-effect waves-light" type="submit">
                            <i class="fa fa-plus" style="margin-right:6px;"></i>Create Campaign
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col s8">
            <div class="card">
                <div class="card-content">
                    <span class="card-title">Campaigns</span>
                    {{#if campaigns.length}}
                    <table class="striped responsive-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Role</th>
                                <th>Privacy</th>
                                <th>Updated</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each campaigns}}
                            <tr>
                                <td>{{{link this.name (concat '/campaigns/campaign/' this._id)}}}</td>
                                <td>
                                    {{#if this.isCreatedByPlayer}}
                                        <span class="badge new blue white-text" data-badge-caption="">Creator</span>
                                    {{else}}
                                        <span class="badge new green white-text" data-badge-caption="">Member</span>
                                    {{/if}}
                                </td>
                                <td>{{this.privacy}}</td>
                                <td>{{formatDateTime this.updatedAt}}</td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                    {{else}}
                    <p class="grey-text">No campaigns yet.</p>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>
    <div class="col s12">
        {{#if canEdit}}
        <div class="col s12">
            <div class="card">
                <div class="card-content">
                    <span class="card-title">Edit Profile</span>
                    <form id="edit-player-form" data-method="PATCH" action="/players/player/{{player._id}}">
                        <div class="input-field">
                            <input id="player-name" name="name" type="text" value="{{player.name}}" required>
                            <label for="player-name" class="active">Display Name</label>
                        </div>
                        <button class="btn waves-effect waves-light" type="submit">
                            <i class="fa fa-save" style="margin-right:6px;"></i>Save
                        </button>
                    </form>
                </div>
            </div>
        </div>
        {{/if}}
    </div>
</div>

<style>
.player-profile-header {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    flex-wrap: wrap;
}
.player-avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #e0e0e0;
}
.player-avatar-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eceff1;
    border: 2px solid #cfd8dc;
}
.player-avatar-placeholder i {
    font-size: 2.4rem;
    color: #90a4ae;
}
.player-profile-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
}
.player-name {
    margin: 0 0 2px;
    font-size: 1.5rem;
    font-weight: 700;
    color: #263238;
}
.player-username, .player-email, .player-since {
    font-size: 0.85rem;
    display: block;
}
.player-profile-stats {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
}
.player-stat-chip {
    text-align: center;
    background: #eceff1;
    border-radius: 8px;
    padding: 8px 18px;
    min-width: 72px;
}
.player-stat-value {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    color: #013979;
    line-height: 1.2;
}
.player-stat-label {
    display: block;
    font-size: 0.75rem;
    color: #607d8b;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}
</style>
