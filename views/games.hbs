<div class="section">
    <h3>Games</h3>

    <div class="row">
        <div class="col s12 m4">
            <div class="card">
                <div class="card-content">
                    <span class="card-title">Create Game</span>
                    <form id="create-game-form" method="POST" action="/games/create">
                        <div class="input-field">
                            <input id="name" name="name" type="text" required>
                            <label for="name">Name</label>
                        </div>
                        <div class="input-field">
                            <textarea id="description" name="description" class="materialize-textarea"></textarea>
                            <label for="description">Description</label>
                        </div>
                        <div class="input-field">
                            <select id="campaign" name="campaign">
                                <option value="" selected>No Campaign</option>
                                {{#each campaignList}}
                                <option value="{{this._id}}">{{this.name}}</option>
                                {{/each}}
                            </select>
                            <label for="campaign" class="active">Campaign</label>
                        </div>
                        {{> field_select_multi list=rosterList selected=null id="rosters" name="rosters" label="Rosters"}}
                        <button class="btn waves-effect waves-light" type="submit">Create Game</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col s12 m8">
            <div class="card">
                <div class="card-content">
                    <span class="card-title">Games</span>
                    <table class="striped responsive-table" id="games-table">
                        <thead>
                        <tr>
                            <th>Name</th>
                            <th>Campaign</th>
                            <th>Rosters</th>
                            <th>Created</th>
                        </tr>
                        </thead>
                        <tbody>
                        {{#each games}}
                            <tr>
                                <td>{{{link this.name (concat '/games/game/' this._id)}}}</td>
                                <td>{{#if this.campaign}}{{this.campaign.name}}{{else}}-{{/if}}</td>
                                <td>{{this.rosters.length}}</td>
                                <td>{{formatDateTime this.createdAt}}</td>
                            </tr>
                        {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>